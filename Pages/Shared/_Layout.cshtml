<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RazorSite</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RazorSite.styles.css" asp-append-version="true" />
</head>
<body class="nf-body">
    <header class="nf-header">
        <div class="nf-left">
            <div class="nf-logo">
                <a asp-page="/Index">ANODAFLEX</a>
            </div>
            <nav class="nf-nav">
                <a asp-page="/Index">音楽</a>
                <a asp-page="/Privacy">シリーズ</a>
                <a asp-page="/About">映画</a>
                <a asp-page="/About">クイズ</a>
                <a asp-page="/About">新作＆人気作</a>
                <a asp-page="/About">マイリスト</a>
            </nav>
        </div>

        <div class="nf-right">
            <button class="nf-icon-btn">🔍</button>
            <span class="nf-kids">キッズ</span>
            <button class="nf-icon-btn">🔔</button>
            <div class="nf-profile"></div>
        </div>
    </header>

    <div class="main-container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="nf-big-footer">
        <div class="nf-footer-container">
            <div class="nf-footer-social">
                <span class="nf-social-icon">📘</span>
                <span class="nf-social-icon">📷</span>
                <span class="nf-social-icon">🐦</span>
                <span class="nf-social-icon">▶️</span>
                <i class="fa-brands fa-twitter"></i>
            </div>

            <div class="nf-footer-links">
                <ul>
                    <li><a href="#">音声ガイド</a></li>
                    <li><a href="#">IR情報</a></li>
                    <li><a href="#">プライバシー</a></li>
                    <li><a href="#">お問い合わせ</a></li>
                </ul>

                <ul>
                    <li><a href="#">ヘルプセンター</a></li>
                    <li><a href="#">採用情報</a></li>
                    <li><a href="#">法的事項</a></li>
                    <li><a href="#">特定商取引法</a></li>
                </ul>

                <ul>
                    <li><a href="#">プリペイド・ギフトカード</a></li>
                    <li><a href="#">公式ショップ</a></li>
                    <li><a href="#">Cookie設定</a></li>
                </ul>

                <ul>
                    <li><a href="#">メディアセンター</a></li>
                    <li><a href="#">利用規約</a></li>
                    <li><a href="#">会社情報</a></li>
                </ul>
            </div>

            <div class="nf-footer-copy">
                © 2001-2025 razorsite, inc.
            </div>
        </div>
    </footer>

    @RenderSection("Scripts", required: false)
    <script>
        const slider = document.querySelector(".nf-top10-slider");

        // → 進む
        document.querySelector(".nf-top10-next")
            .addEventListener("click", function () {
                slider.scrollBy({ left: 1300, behavior: "smooth" });
            });

        // ← 戻る
        document.querySelector(".nf-top10-prev")
            .addEventListener("click", function () {
                slider.scrollBy({ left: -1300, behavior: "smooth" });
            });
    </script>
</body>

</html>
